
# ==================================================
# PLATAFORMA LEGAL V2
# Configuracion de ejemplo para desarrollo local.
#
# Copiar este archivo como .env y configurar
# las credenciales propias de cada computadora.
# Nunca guardar contrasenas reales aqui.
# ==================================================

# Aplicacion
APP_NAME="Plataforma Legal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090

# Idioma
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# Mantenimiento
APP_MAINTENANCE_DRIVER=file

# Seguridad
BCRYPT_ROUNDS=12

# Registros
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos MySQL 8
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plataforma_legal_v2
DB_USERNAME=root
DB_PASSWORD=

# Sesiones
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Eventos, almacenamiento, colas y cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo electronico
# En desarrollo, los correos se registran en los logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Integracion futura con servicios externos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend
VITE_APP_NAME="${APP_NAME}"
