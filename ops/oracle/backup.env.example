# Install root-owned /etc/lefenda/backup.env, 0640 root:lefenda-backup.
# No runtime APP_KEY; custody is a separate procedure.
APP_ENV=production
APP_DEBUG=false
DB_CONNECTION=mysql
DB_HOST=localhost
DB_SOCKET=/run/mysqld/mysqld.sock
DB_DATABASE=lefenda_staging
DB_URL=
QUEUE_CONNECTION=database
LEXA_GENERATION_ENABLED=false
LEXA_PROVIDER=null
MAIL_MAILER=array
APP_CONFIG_CACHE=/etc/lefenda/nonexistent-backup-config.php
APP_PACKAGES_CACHE=/srv/lefenda/current/bootstrap/cache/packages.php
APP_SERVICES_CACHE=/srv/lefenda/current/bootstrap/cache/services.php
APP_URL=https://STAGING_HOST
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
